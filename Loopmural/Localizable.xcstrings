      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込む"
          }
        }
      }
    },
    "Import MP4 Files…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import MP4 Files…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4ファイルを読み込む…"
          }
        }
      }
    },
    "Import MP4 files": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import MP4 files"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4ファイルを読み込む"
          }
        }
      }
    },
    "Import an MP4, then set it as your wallpaper.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import an MP4, then set it as your wallpaper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4ファイルを読み込んで、壁紙に設定しましょう。"
          }
        }
      }
    },
    "Imported MP4 files are copied into Loopmural’s local storage. Removing a video deletes only that copy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported MP4 files are copied into Loopmural’s local storage. Removing a video deletes only that copy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだMP4ファイルはLoopmuralのローカルストレージにコピーされます。動画を削除すると、そのコピーだけが削除されます。"
          }
        }
      }
    },
    "Importing videos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Importing videos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を読み込み中"
          }
        }
      }
    },
    "Launch at Login": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at Login"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動"
          }
        }
      }
    },
    "Loopmural": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopmural"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopmural"
          }
        }
      }
    },
    "MP4 files are copied into your local Loopmural library.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4 files are copied into your local Loopmural library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4ファイルは、このMac上のLoopmuralライブラリにコピーされます。"
          }
        }
      }
    },
    "Muted · Loops on all displays": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muted · Loops on all displays"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消音・すべての画面でループ再生"
