    "Your videos and library data stay on your Mac. Loopmural does not upload your videos or include tracking or analytics.": {
      "comment": "Privacy summary shown in Settings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your videos and library data stay on your Mac. Loopmural does not upload your videos or include tracking or analytics."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画とライブラリのデータはこのMacに保存されます。Loopmuralは動画をアップロードせず、トラッキングやアクセス解析も行いません。"
          }
        }
      }
