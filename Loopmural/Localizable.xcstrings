    },
    "The video library could not be opened. Restart Loopmural and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video library could not be opened. Restart Loopmural and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画ライブラリを開けませんでした。Loopmuralを再起動して、もう一度お試しください。"
          }
        }
      }
    },
    "This library video is missing. Remove it and import the MP4 again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This library video is missing. Remove it and import the MP4 again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この動画のファイルが見つかりません。ライブラリから削除して、MP4ファイルをもう一度読み込んでください。"
          }
