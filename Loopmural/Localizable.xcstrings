{
  "sourceLanguage": "en",
  "strings": {
    "%lld videos": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld video"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld videos"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld本の動画"
          }
        }
      },
      "comment": "Number of imported videos in the library footer."
    },
    "A little motion for your desktop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little motion for your desktop"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップに、さりげない動きを"
          }
        }
      }
    },
    "All connected displays": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All connected displays"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続されているすべてのディスプレイ"
          }
        }
      }
    },
    "Allow Loopmural in System Settings to finish enabling launch at login.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Loopmural in System Settings to finish enabling launch at login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時の自動起動を有効にするには、システム設定でLoopmuralを許可してください。"
          }
        }
      }
    },
    "Always muted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always muted"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に消音"
          }
        }
      }
    },
    "Audio": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio"
          }
        },
        "ja": {
          "stringUnit": {
