    },
    "Choose a playable MP4 with a video track and a finite duration.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a playable MP4 with a video track and a finite duration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像が含まれている、再生可能なMP4ファイルを選択してください。再生時間が確定している必要があります。"
          }
        }
      }
    },
    "Dismiss error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss error"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラーメッセージを閉じる"
