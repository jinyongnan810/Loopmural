    "Playback pauses while your displays sleep or your user session is inactive.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback pauses while your displays sleep or your user session is inactive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイのスリープ中や、ユーザーセッションが非アクティブな間は再生を一時停止します。"
          }
        }
      }
    },
    "Playing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playing"
          }
        },
        "ja": {
