    "Remove “%@” from your library? Only Loopmural’s copy is deleted. Your original MP4 stays untouched.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove “%@” from your library? Only Loopmural’s copy is deleted. Your original MP4 stays untouched."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をライブラリから削除しますか？Loopmuralのコピーだけが削除されます。元のMP4ファイルは削除されません。"
          }
        }
      },
      "comment": "The placeholder is the user-provided video filename without its extension."
    },
    "Restore Last Wallpaper": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Last Wallpaper"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の壁紙を復元"
          }
        }
      }
    },
    "Restore your last selected video when Loopmural opens. A paused wallpaper stays paused.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore your last selected video when Loopmural opens. A paused wallpaper stays paused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopmuralの起動時に、前回選択した動画を復元します。一時停止していた壁紙は、一時停止したまま復元されます。"
          }
        }
